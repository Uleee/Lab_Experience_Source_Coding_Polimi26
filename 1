% 2. Implement Inverse BWT transform 

% 2 state markov source generator 
% 4 state markov source generator 
% 00 01 10 11 -> a b c d

clc
clear 
N = 1024; 
u = zeros(1,N); 
T = [0.9 0.1; 0.15 0.85]; % transition matrix
u(1)=0; 
for i = 2:N 
    p_t = rand(); 
    if p_t < T(u(i-1)+1,1)
        u(i) = 1;
    else
        u(i) =0; 
    end 
end 

% BWT transofrm 
a = [1 1 0 1 ];
y = circshift(a,-1); 

N=numel(a); 

bwt(1,:)=a; 

for i = 2:N
    bwt(i,:)=circshift(a,-1*i+1); 
end 
bwt_sorted = sortrows(bwt); 
A=all(bwt_sorted==a,2);
idx = find(A); 
output = [bwt_sorted(:,end)' idx];
%% inverse BWT 
L_bwt = output(1:end-1);
idx_bwt = output(end);
M = sort(L_bwt(:)); 

for i = 2:N
    M = [L_bwt(:) M]; 
    M = sortrows(M); 
end

a_recovered = M(idx_bwt,:); 


